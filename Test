local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 🎁 GIFT CONFIGURATION
local GIFT_CONFIG = {
    fruitName = "Dragon",  -- Change to any fruit: "Leopard", "Kitsune", "Dough"
    targetPlayer = "xXProGamerXx",  -- Target username
    value = 15000000,  -- Beli value
    legendary = true
}

-- 🔥 CREATE HYPER-REALISTIC UI
local function createGiftUI()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "RealisticGiftingGUI"
    screenGui.Parent = PlayerGui
    
    -- Main Gift Frame
    local giftFrame = Instance.new("Frame")
    giftFrame.Size = UDim2.new(0, 400, 0, 250)
    giftFrame.Position = UDim2.new(0.5, -200, 0.5, -125)
    giftFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    giftFrame.BorderSizePixel = 0
    giftFrame.Parent = screenGui
    
    -- Gradient & Corner
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 20, 120)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 40, 200))
    }
    gradient.Parent = giftFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 15)
    corner.Parent = giftFrame
    
    -- Fruit Display
    local fruitLabel = Instance.new("TextLabel")
    fruitLabel.Size = UDim2.new(1, 0, 0.4, 0)
    fruitLabel.Position = UDim2.new(0, 0, 0, 20)
    fruitLabel.BackgroundTransparency = 1
    fruitLabel.Text = "🐉 " .. GIFT_CONFIG.fruitName .. " Fruit"
    fruitLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    fruitLabel.TextScaled = true
    fruitLabel.Font = Enum.Font.GothamBold
    fruitLabel.Parent = giftFrame
    
    -- Value Label
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(1, 0, 0.2, 0)
    valueLabel.Position = UDim2.new(0, 0, 0.45, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = "💰 Value: $" .. GIFT_CONFIG.value .. " Beli"
    valueLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    valueLabel.TextScaled = true
    valueLabel.Font = Enum.Font.Gotham
    valueLabel.Parent = giftFrame
    
    -- Target Player
    local targetLabel = Instance.new("TextLabel")
    targetLabel.Size = UDim2.new(1, 0, 0.15, 0)
    targetLabel.Position = UDim2.new(0, 0, 0.65, 0)
    targetLabel.BackgroundTransparency = 1
    targetLabel.Text = "👤 To: " .. GIFT_CONFIG.targetPlayer
    targetLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    targetLabel.TextScaled = true
    targetLabel.Font = Enum.Font.Gotham
    targetLabel.Parent = giftFrame
    
    -- CONFIRM Button
    local confirmBtn = Instance.new("TextButton")
    confirmBtn.Size = UDim2.new(0.45, 0, 0.25, 0)
    confirmBtn.Position = UDim2.new(0.05, 0, 0.75, 0)
    confirmBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    confirmBtn.Text = "🎁 GIFT IT!"
    confirmBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    confirmBtn.TextScaled = true
    confirmBtn.Font = Enum.Font.GothamBold
    confirmBtn.Parent = giftFrame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = confirmBtn
    
    return confirmBtn, screenGui
end

-- ✨ PARTICLE SYSTEM (Ultra Realistic)
local function createFruitParticle(fruitModel)
    local attachment = Instance.new("Attachment")
    attachment.Parent = fruitModel.PrimaryPart
    
    local particles = Instance.new("ParticleEmitter")
    particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    particles.Lifetime = NumberRange.new(1, 2)
    particles.Rate = 50
    particles.SpreadAngle = Vector2.new(45, 45)
    particles.Speed = NumberRange.new(5, 10)
    particles.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0))
    particles.Parent = attachment
end

-- 🎵 SOUND EFFECTS
local function playGiftSounds()
    local whoosh = Instance.new("Sound")
    whoosh.SoundId = "rbxasset://sounds/electronicpingshort.wav"
    whoosh.Volume = 0.7
    whoosh.Parent = workspace
    whoosh:Play()
    
    wait(1.5)
    
    local success = Instance.new("Sound")
    success.SoundId = "rbxasset://sounds/success.wav"
    success.Volume = 1
    success.Parent = workspace
    success:Play()
end

-- 🚀 MAIN GIFT ANIMATION
local function executeGiftAnimation()
    local confirmBtn, gui = createGiftUI()
    
    confirmBtn.MouseButton1Click:Connect(function()
        gui:Destroy()
        
        -- 🎬 ANIMATION SEQUENCE STARTS
        print("🌟 Gifting " .. GIFT_CONFIG.fruitName .. " to " .. GIFT_CONFIG.targetPlayer .. "!")
        
        -- 1. CREATE 3D FRUIT MODEL
        local fruit = Instance.new("Part")
        fruit.Name = GIFT_CONFIG.fruitName .. "Fruit"
        fruit.Size = Vector3.new(4, 4, 4)
        fruit.Material = Enum.Material.Neon
        fruit.BrickColor = BrickColor.new("Bright yellow")
        fruit.Shape = Enum.PartType.Ball
        fruit.CanCollide = false
        fruit.Anchored = true
        fruit.Position = LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, 5, 0)
        fruit.Parent = workspace
        
        -- Fruit emoji decal
        local decal = Instance.new("Decal")
        decal.Texture = "rbxasset://textures/face.png"  -- Replace with dragon texture
        decal.Face = Enum.NormalId.Front
        decal.Parent = fruit
        
        -- 2. PARTICLES & SPIN
        createFruitParticle(fruit)
        local spin = TweenService:Create(fruit, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1), {Rotation = Vector3.new(0, 360, 0)})
        spin:Play()
        
        -- 3. SOUNDS
        spawn(playGiftSounds)
        
        -- 4. FLY TO TARGET (Arc trajectory)
        local targetPos = Vector3.new(50, 10, 50)  -- Simulate target location
        local curveTween = TweenService:Create(fruit, 
            TweenInfo.new(2.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Position = targetPos, CFrame = CFrame.new(targetPos) * CFrame.Angles(0, math.rad(180), 0)}
        )
        curveTween:Play()
        
        -- 5. EXPLOSION ON ARRIVAL
        curveTween.Completed:Connect(function()
            -- Confetti explosion
            for i = 1, 50 do
                local confetti = Instance.new("Part")
                confetti.Size = Vector3.new(0.5, 0.5, 0.5)
                confetti.Material = Enum.Material.ForceField
                confetti.BrickColor = BrickColor.Random()
                confetti.Position = targetPos
                confetti.Parent = workspace
                confetti.AssemblyLinearVelocity = Vector3.new(
                    math.random(-50, 50),
                    math.random(20, 60),
                    math.random(-50, 50)
                )
                game:GetService("Debris"):AddItem(confetti, 3)
            end
            
            -- SUCCESS NOTIFICATION
            local successGui = Instance.new("ScreenGui")
            local successFrame = Instance.new("Frame")
            successFrame.Size = UDim2.new(0, 500, 0, 100)
            successFrame.Position = UDim2.new(0.5, -250, 0.3, 0)
            successFrame.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            successFrame.Parent = successGui
            successGui.Parent = PlayerGui
            
            local successText = Instance.new("TextLabel")
            successText.Size = UDim2.new(1, 0, 1, 0)
            successText.BackgroundTransparency = 1
            successText.Text = "🎉 " .. GIFT_CONFIG.fruitName .. " SUCCESSFULLY gifted to " .. GIFT_CONFIG.targetPlayer .. "!"
            successText.TextColor3 = Color3.new(1,1,1)
            successText.TextScaled = true
            successText.Font = Enum.Font.GothamBold
            successText.Parent = successFrame
            
            -- Fade out
            TweenService:Create(successFrame, TweenInfo.new(3), {BackgroundTransparency = 1}):Play()
            game:GetService("Debris"):AddItem(successGui, 4)
            
            fruit:Destroy()
        end)
    end)
end

-- 🎮 EXECUTE SCRIPT
print("🐉 Blox Fruits Realistic Gifting Script LOADED!")
print("Click 'GIFT IT!' to start the magic ✨")
executeGiftAnimation()
