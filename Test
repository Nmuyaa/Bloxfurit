-- Fake gift sequence (mimics REAL gifting)
local function executeFakeGift()
    local targetPlayer = Players:FindFirstChild(TARGET)
    if not targetPlayer then 
        TARGET = Players:GetPlayers()[math.random(2, #Players:GetPlayers())].Name  -- Random nearby
        targetPlayer = Players:FindFirstChild(TARGET)
    end
    
    -- 1. Fire fake gift remote (invisible)
    pcall(function()
        ReplicatedStorage.Remotes["GiftPermanentFruit"]:FireServer(TARGET, FRUIT)
    end)
    
    -- 2. Server-style chat notifications (everyone sees)
    chatRemote:FireServer(player.Name .. " gifted a Permanent " .. FRUIT .. " to " .. TARGET .. "!", "All")
    wait(0.5)
    chatRemote:FireServer("💎 " .. player.Name .. " gifted Permanent " .. FRUIT .. " worth 25k Robux to " .. TARGET .. "!", "All")
    
    -- 3. Cooldown message (realistic)
    chatRemote:FireServer(player.Name .. " (2h cooldown active)", "All")
    
    -- 4. Target receives "confirmation" (private chat)
    chatRemote:FireServer("You received Permanent " .. FRUIT .. " from " .. player.Name .. "! Value: 25,000 Robux", "All")
    
    print("🎁 FAKED: " .. FRUIT .. " → " .. TARGET .. " (Real chat effects)")
end

